# Configuração não secreta. Os segredos são gerados no volume alece_secrets.
ALECE_BIND_IP=127.0.0.1
ALECE_PORT=8088
ALECE_DEBUG=false
ALECE_ALLOWED_HOSTS=localhost,127.0.0.1
ALECE_CSRF_TRUSTED_ORIGINS=
ALECE_SECURE_COOKIES=false
ALECE_USE_X_FORWARDED_HOST=false
ALECE_USE_X_FORWARDED_PORT=false
ALECE_SECURE_PROXY_SSL=false
ALECE_DB_NAME=alece
ALECE_DB_USER=alece
ALECE_DB_HOST=db
ALECE_DB_PORT=5432
ALECE_LOG_LEVEL=INFO
# Salva cada inicializacao em src/logs/ (true/false).
ALECE_LOG_VALIDACAO=true

# Para execução sem Docker, forneça ALECE_SECRET_KEY e ALECE_DB_PASSWORD
# no ambiente; não inclua segredos em arquivos públicos.

# Integração IA (opt-in): vazio por padrão; nenhum envio externo.
ALECE_AI_ALLOWED_HOSTS=
# Chaves fornecidas pela interface administrativa ficam no volume app_ai_tokens.
# Não adicione API keys neste arquivo.
