# NUNCA commitar .env. Preencher com valores únicos antes de executar.
ALECE_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
ALECE_DEBUG=false
ALECE_ALLOWED_HOSTS=localhost,127.0.0.1
ALECE_CSRF_TRUSTED_ORIGINS=
# Padrão apenas loopback; para LAN no ZimaOS configure o IP de bind e ALLOWED_HOSTS.
ALECE_BIND_IP=127.0.0.1
ALECE_PORT=8000
ALECE_SECURE_COOKIES=false
ALECE_DB_NAME=alece
ALECE_DB_USER=alece
ALECE_DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD
ALECE_DB_HOST=db
ALECE_DB_PORT=5432
ALECE_LOG_LEVEL=INFO
